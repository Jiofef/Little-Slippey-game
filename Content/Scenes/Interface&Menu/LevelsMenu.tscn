[node name="JiofefsHead" parent="MarginContainer/VBoxContainer/HBC/Additions/VBC/ChallengesContainer" index="2" instance=ExtResource("23_at464")]
layout_mode = 2
disabled = true
toggle_mode = true
script = ExtResource("22_at464")
_contentName = "JiofefsHead"
_displayedName = "Jiofef's Presence"
Icon = ExtResource("23_mno7b")
AnnotationEnabled = true
AnnotationText = "Jiofef (Jio Yoba Fefski) arrived in this world when it was already too late. It might seem obvious to blame all the world’s suffering on a being with absolute power—but Jiofef is merely a reflection of society. He won’t destroy the world outright. Instead, he’ll keep it teetering on the edge, artificially sparking wars and unleashing horrific calamities, occasionally targeting utterly insignificant individuals for his cruel amusement. No one knows why he does this. Maybe he enjoys it. Maybe it’s part of some \"Grand Design.\" Whatever the case, the consequences of his actions are undeniable. And though most people remain unaware of his existence, everyone should stay vigilant. When word of his arrival reached certain Giero employees, they formed a cult. Some believe unwavering loyalty will earn them his favor, while others genuinely hope to appease him—sparing humanity from his wrath.
Rumors claim Jiofef lacks full control over his actions. Of course, such nonsense couldn’t possibly be true. The sheer scale of his power is already almost impossible to comprehend. A being capable of controlling him? Unthinkable. Besides, the cultist who spread that rumor was committed to a psychiatric ward within a week. A month later, he died of heart failure. Who knows what really broke the poor bastard’s mind?"

[node name="EnhancedCrosses" parent="MarginContainer/VBoxContainer/HBC/Additions/VBC/ChallengesContainer" index="3" instance=ExtResource("23_at464")]
layout_mode = 2
disabled = true
toggle_mode = true
script = ExtResource("22_at464")
_contentName = "EnhancedCrosses"
_displayedName = "Enhanced Crosses"
Icon = ExtResource("19_mgyur")
AnnotationEnabled = true
AnnotationText = "The \"LW-TNT 2000\" was developed by Giero Labs as an upgrade to the more primitive \"LW-TNT 1000\"—yet it never left the testing phase. The amount of TNT in these markers is too low to cause any real damage, let alone be useful in mining or demolitions. Increasing the payload would make them too heavy, ruining their functionality. But hey, at least they siphoned some sweet cash during development."

