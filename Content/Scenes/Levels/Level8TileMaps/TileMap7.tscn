[connection signal="ButtonPressed" from="DisposableButton4" to="DisposableButton4/Explosion/CPUParticles2D" method="set_emitting" binds= [true]]
[connection signal="animation_finished" from="DisposableButton4/Explosion/ExplosionAnimation" to="DisposableButton4/Explosion/ExplosionAnimation" method="set_visible" binds= [false]]
