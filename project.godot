; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Little Slippey"
run/main_scene="res://Content/Scenes/Interface&Menu/InitializationScene.tscn"
run/print_header=false
config/use_custom_user_dir=true
config/features=PackedStringArray("4.4", "C#")
run/max_fps=60
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

buses/channel_disable_threshold_db=-30.0
buses/channel_disable_time=0.0

[autoload]

UnchangableMeta="*res://Content/Scripts/Singletons/UnchangableMeta.cs"
Meta="*res://Content/Scripts/Singletons/Meta.cs"
Achievements="*res://Content/Scripts/Singletons/Achievements.cs"
ModDataManager="*res://Content/Scripts/Singletons/ModDataManager.cs"
ModManager="*res://Content/Scripts/Singletons/ModManager.cs"
FileSystemExtension="*res://Content/Scripts/Singletons/FileSystemExtension.cs"
G="*res://Content/Scripts/Singletons/G.cs"
AdditionalGuiSingleton="*res://Content/Scripts/Singletons/AdditionalGuiSingleton.cs"
Skins="*res://Content/Scripts/Singletons/Skins.cs"
Crosses="*res://Content/Scripts/Singletons/Crosses.cs"
Resources="*res://Content/Scripts/Singletons/Resources.cs"
CommandConsole="*res://addons/csharpConsole/CommandConsole.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stdout/print_fps=false
window/stdout/print_gpu_profile=false
window/stdout/verbose_stdout=false
window/driver/driver_name="GLES2"
window/import_etc=true
window/glow/upscale_mode=0

[dotnet]

project/assembly_name="Little Slippey"

[editor_plugins]

enabled=PackedStringArray("res://addons/csharpConsole/plugin.cfg")

[file_customization]

folder_colors={
"res://Content/": "purple",
"res://Content/Other/": "gray",
"res://Content/Scenes/": "blue",
"res://Content/Scripts/": "pink",
"res://Content/Sounds/": "yellow",
"res://Content/Sprites/": "green"
}

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

[gui]

theme/custom="res://Content/Other/Default.theme"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
common/drop_mouse_on_gui_input_disabled=true

