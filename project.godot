[internationalization]

locale/translation_remaps={
"res://Content/Other/AhahahSillyVideo.ogv": PackedStringArray("res://Content/Other/AhahahSillyVideoRussian.ogv:ru"),
"res://Content/Sprites/Levels/Level4/Object4.png": PackedStringArray("res://Content/Sprites/Levels/Level4/Object4Ru.png:ru"),
"res://Content/Sprites/Levels/Level4/TubeEng.png": PackedStringArray("res://Content/Sprites/Levels/Level4/TubeRu.png:ru")
}
locale/translations=PackedStringArray("res://Content/Other/Localization.en.translation", "res://Content/Other/Localization.ru.translation")
locale/locale_filter_mode=0
locale/language_filter=["en", "ru"]

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="PlayerSide"
2d_physics/layer_3="Tiles"
2d_physics/layer_4="PlayerHitBox"
2d_physics/layer_5="Death"
2d_physics/layer_6="BlumCrossButton"
2d_physics/layer_7="ForegroundArea"
2d_physics/layer_8="Level6FlyingCar"
2d_physics/layer_9="RigidBodies"
2d_physics/layer_10="OneWayCollisionTiles"

[mono]

project/assembly_name="Little Slippey"

[physics]

common/enable_pause_aware_picking=true
3d/vsync/vsync_mode=2

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/glow/upscale_mode=0
environment/defaults/default_environment="res://default_env.tres"
